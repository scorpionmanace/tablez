{
  "name": "@scorpionmanace/tablez",
  "description": "A modern, highly customizable, and performant React data table library with virtual scrolling and hierarchical tree support.",
  "keywords": [
    "react-table",
    "data-table",
    "virtual-scroll",
    "tree-view",
    "headless",
    "formula-engine",
    "performance",
    "typescript"
  ],
  "author": "Karan Khare",
  "license": "MIT",
  "private": false,
  "version": "1.0.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/tablez.cjs",
  "module": "./dist/tablez.es.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/tablez.es.js",
      "require": "./dist/tablez.cjs"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.es.js",
      "require": "./dist/native.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "preview": "vite preview",
    "prepublishOnly": "npm run build && npm run verify-package",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "*"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "storybook": "^8.6.12",
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-native": "^0.72.8",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^22.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.80.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.0.18"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
